# 複製成 deploy/application.properties 後填寫，不要提交到 Git。啟動方式見 backend/README.md。
# 每行 KEY=VALUE，不加 export 或外層引號；註解另起一行。Windows 路徑用 /，反斜線寫成 \\。

# 服務監聽位址、註冊到 Eureka 的 IP、Eureka 網址。
INTERNAL_BIND_ADDRESS=127.0.0.1
SERVICE_IP_ADDRESS=127.0.0.1
EUREKA_URL=http://127.0.0.1:8761/eureka/

# 先建好資料庫與專用帳號（不用 root），再填連線網址和帳密；db.internal 換成資料庫主機。
BASIC_DATA_DB_URL=jdbc:mysql://db.internal:3306/basic_data?serverTimezone=Asia/Taipei&characterEncoding=utf-8
BASIC_DATA_DB_USERNAME=basic_data_app
BASIC_DATA_DB_PASSWORD=
PROJECT_DB_URL=jdbc:mysql://db.internal:3306/project?serverTimezone=Asia/Taipei&characterEncoding=utf-8
PROJECT_DB_USERNAME=project_app
PROJECT_DB_PASSWORD=
NOTIFICATION_DB_URL=jdbc:mysql://db.internal:3306/notification?serverTimezone=Asia/Taipei&characterEncoding=utf-8
NOTIFICATION_DB_USERNAME=notification_app
NOTIFICATION_DB_PASSWORD=
# 儲存登入狀態的資料庫，先建立 SPRING_SESSION 與 SPRING_SESSION_ATTRIBUTES 兩張表。
WEB_SESSION_DB_URL=jdbc:mysql://db.internal:3306/basic_data?serverTimezone=Asia/Taipei&characterEncoding=utf-8
WEB_SESSION_DB_USERNAME=web_session_app
WEB_SESSION_DB_PASSWORD=

# 各 OIDC 的 issuer、Client ID／Secret 存 MySQL 的 oidc_client_registration。
# 先建表並匯入 Google 設定，參考 deploy/google-oidc.md 與 oidc-clients.sql.example。
APP_FRONTEND_URL=https://project-manage.jianwii.dev
# 對外網址，結尾不加 /；在 Google Auth Platform 登記此網址加上 /auth/callback/google 作為回呼網址。
APP_PUBLIC_URL=https://project-manage.jianwii.dev/backend
# 超級管理員登入後 /api/auth/me 回傳的 subject（oidc: 開頭，非 Google 原始 sub），多個用逗號分隔；留空表示不設定。
APP_SUPER_ADMIN_SUBJECTS=

# 上傳目錄：先建立並開放服務帳號讀寫，放在程式目錄外；Windows 例如 D:/spring-data/uploads。
APP_UPLOAD_DIR=/srv/spring-data/uploads
# 舊任務附件目錄，服務須能讀取；沒有舊檔也要填一個獨立空目錄。
APP_LEGACY_ATTACHMENT_DIR=/srv/spring-data/legacy-attachments
# 搬過上傳目錄才填原 data/uploads 的絕對路徑；沒有舊檔或沿用原目錄則留空。
APP_LEGACY_UPLOAD_DIR=

# SES 範例使用東京區；endpoint、網域驗證與 SMTP 憑證須屬於同一區域，見 deploy/ses-mail.md。
SMTP_HOST=email-smtp.ap-northeast-1.amazonaws.com
SMTP_PORT=587
# 填 SES 產生的 SMTP username／password，不使用 Gmail 帳密或 IAM 使用者顯示名稱。
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=No Reply <no-reply@jianwii.dev>
spring.mail.properties.mail.smtp.starttls.required=true
# 新部署尚未配置 SMTP 時先保持 false；正式寄信需改為 true，站內通知不受影響。
APP_MAIL_ENABLED=false
# 通知郵件主旨的系統名稱，可依部署用途更換；寄件名稱另由 SMTP_FROM 設定。
APP_DISPLAY_NAME=案步就班
