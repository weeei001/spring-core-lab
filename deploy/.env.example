# 設定範本；Spring Boot 不會自動讀取 .env。
# 由服務管理器或目前 shell 注入；不要把填好的檔案加入 Git。
# 各服務只需收到自己使用的變數與資料庫權限。
# 對外只開前端及 web-server；業務服務、Eureka、DB 與管理 port 限內部存取。
# 入口代理須覆寫外來 Forwarded/X-Forwarded-*，不轉送 /actuator。
# 啟動順序：DB/authentik → Eureka → 業務服務 → 單一 web-server → 前端。
# DB 由人工維護；備份先停寫，涵蓋三庫與所有新舊附件，隔離還原確認後才切換。
SPRING_PROFILES_ACTIVE=deploy
INTERNAL_BIND_ADDRESS=127.0.0.1
SERVICE_IP_ADDRESS=127.0.0.1
EUREKA_URL=http://127.0.0.1:8761/eureka/

# 必須先建立資料庫與專用帳號，不可使用 root 或 createDatabaseIfNotExist。
# 多主機時改為內部主機名稱，TLS 參數依實際 DB 憑證設定。
BASIC_DATA_DB_URL=jdbc:mysql://db.internal:3306/basic_data?serverTimezone=Asia/Taipei&characterEncoding=utf-8
BASIC_DATA_DB_USERNAME=basic_data_app
BASIC_DATA_DB_PASSWORD=
PROJECT_DB_URL=jdbc:mysql://db.internal:3306/project?serverTimezone=Asia/Taipei&characterEncoding=utf-8
PROJECT_DB_USERNAME=project_app
PROJECT_DB_PASSWORD=
NOTIFICATION_DB_URL=jdbc:mysql://db.internal:3306/notification?serverTimezone=Asia/Taipei&characterEncoding=utf-8
NOTIFICATION_DB_USERNAME=notification_app
NOTIFICATION_DB_PASSWORD=
# web-server 工作階段；先在目標資料庫建立 SPRING_SESSION 與 SPRING_SESSION_ATTRIBUTES。
WEB_SESSION_DB_URL=jdbc:mysql://db.internal:3306/basic_data?serverTimezone=Asia/Taipei&characterEncoding=utf-8
WEB_SESSION_DB_USERNAME=web_session_app
WEB_SESSION_DB_PASSWORD=

AUTHENTIK_ISSUER_URI=https://identity.example.invalid/application/o/spring-core-lab/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
APP_FRONTEND_URL=https://projects.example.invalid
# 不加尾端斜線；authentik callback 註冊成 APP_PUBLIC_URL/auth/callback。
APP_PUBLIC_URL=https://projects.example.invalid
# authentik subject，逗號分隔；空白代表沒有超級管理員。
APP_SUPER_ADMIN_SUBJECTS=

# 必須事先建立、授權服務帳號讀寫，位於程式發佈與工作目錄之外。
# Windows 可用 D:/spring-core-lab-data/uploads 這類絕對路徑。
APP_UPLOAD_DIR=/srv/spring-core-lab-data/uploads
# 舊任務附件原目錄，必填且可讀；沒有舊檔時仍指定獨立空目錄。
APP_LEGACY_ATTACHMENT_DIR=/srv/spring-core-lab-data/legacy-attachments
# 曾經使用共用上傳且更換目錄時，填原 data/uploads 的絕對路徑。
# 沒有舊共用檔案或 APP_UPLOAD_DIR 沿用原目錄時可留空。
APP_LEGACY_UPLOAD_DIR=

SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.invalid
# 驗收必須保持 false。站內通知照常運作，不入信件佇列、不派送舊佇列。
APP_MAIL_ENABLED=false
